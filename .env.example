# =========================================================================
# FitLife Sync - Exemplo de variáveis de ambiente
# Copie para .env e substitua os campos vazios por valores reais.
# Nunca versione o arquivo .env.
# =========================================================================

# Obrigatório apenas para publicar pelo Cloudflare Tunnel.
TUNNEL_TOKEN=

# Backend
PORT=3000
NODE_ENV=production
# Gere com `openssl rand -base64 48`; não use texto de exemplo.
JWT_SECRET=
DB_PATH=/app/data/database.sqlite
# Ative somente quando a documentação da API precisar ficar pública.
API_DOCS_ENABLED=false
# Sessões ativas por usuário e tempo máximo sem atividade antes da revogação.
MAX_ACTIVE_SESSIONS=5
SESSION_IDLE_TIMEOUT_DAYS=30
# Em produção, injete um store compartilhado na composição da aplicação.
RATE_LIMIT_PASS_ON_STORE_ERROR=false
