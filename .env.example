# =========================================================================
# FitLife Sync - Arquivo de Exemplo de Variáveis de Ambiente (.env)
# Copie este arquivo para um novo arquivo chamado '.env' e ajuste os valores.
# =========================================================================

# Token do Cloudflare Tunnel (Obrigatório para expor o serviço de forma segura)
# Crie o túnel em: Cloudflare Dashboard > Zero Trust > Networks > Tunnels
TUNNEL_TOKEN=seu_token_do_cloudflare_tunnel_aqui

# Configurações do Backend (Opcional - caso queira customizar via .env)
# PORT=3000
# NODE_ENV=development
# JWT_SECRET=fitlife_sync_super_secret_key_123
# DB_PATH=/app/data/database.sqlite

# Worker de tradução (Opcional)
# TRANSLATION_POLL_INTERVAL_MS=15000
# TRANSLATION_WORK_INTERVAL_MS=800
# TRANSLATION_RETRY_DELAY_MS=5000
# TRANSLATION_CLAIM_TIMEOUT_MS=300000
