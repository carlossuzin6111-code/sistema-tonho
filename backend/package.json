{
  "name": "fitlife-sync-backend",
  "version": "1.0.0",
  "description": "Backend API for Personal Trainer and Student Management System",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "test": "jest --runInBand --detectOpenHandles",
    "migrate": "knex migrate:latest --knexfile knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.js",
    "migrate:status": "knex migrate:status --knexfile knexfile.js",
    "access-key:create": "node src/scripts/createAccessKey.js",
    "db:backup": "node src/scripts/backupDatabase.js",
    "db:restore": "node src/scripts/restoreBackup.js",
    "db:verify-backup": "node src/scripts/verifyBackup.js",
    "worker:translate": "node src/workers/runTranslationWorker.js",
    "worker:backup": "node src/workers/runBackupWorker.js"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/setupLifecycle.js"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.2.10",
    "sharp": "^0.35.3",
    "sqlite3": "^6.0.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
